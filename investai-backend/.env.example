# investai-backend/.env
# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# ── Security ──────────────────────────────────────────────────────────────────
# Used for signing this app's own state; user auth is Supabase's job (below).
SECRET_KEY=your-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Supabase JWT verification (app/dependencies.py). Current Supabase projects
# sign tokens with asymmetric ES256 keys, which are verified via the project's
# JWKS — leave SUPABASE_JWT_SECRET blank for that. Only a legacy project that
# still issues HS256 tokens needs the shared secret from Dashboard ->
# Project Settings -> API -> JWT Keys. Do not add a secret "just in case":
# the code verifies the token header's alg and picks the path.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Only Celery touches Redis; the API request path never does.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Firebase Cloud Messaging (push, I-12) ────────────────────────────────────
# Point this at a service-account JSON (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Keep the file out of git —
# *.json is gitignored here for exactly that reason. Without it, every push is
# skipped with a warning and everything else works.
FIREBASE_CREDENTIALS_PATH=firebase-key.json
# On a host with no persistent disk (Railway, Render, Fly), put the whole
# service-account JSON in this variable instead; it wins over the path.
FIREBASE_CREDENTIALS_JSON=
# Legacy server key, no longer used by the v1 API; retained only so an old
# .env still loads. Safe to leave blank.
FCM_SERVER_KEY=

# ── LLM providers ─────────────────────────────────────────────────────────────
# NVIDIA is the primary provider; OpenRouter is used automatically only when
# NVIDIA fails, is unavailable, rate-limited, or times out. Both are free tiers.
#   NVIDIA key:     https://build.nvidia.com  (starts nvapi-)
#   OpenRouter key: https://openrouter.ai/settings/keys  (starts sk-or-v1-)
# Either one alone is enough to boot; with only OpenRouter set there is no
# fallback, and with neither set the AI features degrade to their templates.
NVIDIA_API_KEY=nvapi-your-nvidia-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Model overrides — optional, the defaults in app/config.py are the ones that
# were benchmarked (see docs/MODEL_SELECTION.md). Set these only to swap models
# without a code change, e.g. if a free tier is retired.
# NVIDIA_AGENT_MODEL=openai/gpt-oss-20b
# NVIDIA_UTILITY_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OPENROUTER_AGENT_MODEL=minimax/minimax-m3:free
# OPENROUTER_UTILITY_MODEL=minimax/minimax-m3:free
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# LLM_TIMEOUT_SECONDS=20.0

# ── Brevo (transactional email: OTP, welcome, reset) ─────────────────────────
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-brevo-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=InvestAI

# ── App Settings ──────────────────────────────────────────────────────────────
# "production" hides /docs, /redoc and /openapi.json and disables the operator
# endpoints POST /stocks/scrape and POST /notifications/test.
ENVIRONMENT=development
DEBUG=false
API_VERSION=v1
# Comma-separated browser origins allowed by CORS. The mobile app is not a
# browser and ignores this; it matters for the Expo web target only.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
LOG_LEVEL=INFO
# Used for OpenRouter attribution headers and (future) web redirects.
FRONTEND_URL=
