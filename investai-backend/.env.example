# investai-backend/.env
# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your-very-long-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis / Celery ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key

# ── LLM providers ─────────────────────────────────────────────────────────────
# NVIDIA is the primary provider; OpenRouter is used automatically only when
# NVIDIA fails, is unavailable, rate-limited, or times out. Both are free tiers.
#   NVIDIA key:     https://build.nvidia.com  (starts nvapi-)
#   OpenRouter key: https://openrouter.ai/settings/keys  (starts sk-or-v1-)
# Either one alone is enough to boot; with only OpenRouter set there is no
# fallback, and with neither set the AI features degrade to their templates.
NVIDIA_API_KEY=nvapi-your-nvidia-key
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Model overrides — optional, the defaults in app/config.py are the ones that
# were benchmarked (see docs/MODEL_SELECTION.md). Set these only to swap models
# without a code change, e.g. if a free tier is retired.
# NVIDIA_AGENT_MODEL=openai/gpt-oss-20b
# NVIDIA_UTILITY_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OPENROUTER_AGENT_MODEL=minimax/minimax-m3:free
# OPENROUTER_UTILITY_MODEL=minimax/minimax-m3:free
# NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# LLM_TIMEOUT_SECONDS=20.0

# ── App Settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_VERSION=v1
