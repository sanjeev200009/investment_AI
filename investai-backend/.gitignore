# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
bin/
build/
develop-eggs/
dist/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDEs
.vscode/
.idea/

# Environment Variables & Secrets
.env
# `.env` alone does not match `.env.local`, `.env.backup-*` etc., and those hold
# real keys just as `.env` does. `.env.example` is re-admitted below because it
# contains placeholders only and must stay in version control.
.env.*
!.env.example
*.json
!composer.json
!package.json
!tsconfig.json

# Logs
*.log
