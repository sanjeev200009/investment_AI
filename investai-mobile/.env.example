# .env.example — copy to .env and fill in
#
# Where the mobile app finds the FastAPI backend. For a physical device or
# emulator, localhost will not resolve to your machine — use your LAN IP or a
# tunnel (the app already sends the ngrok-skip-browser-warning header).
# Note the /api/v1 suffix: every backend route lives under that prefix.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# No other variables are required. Auth is Supabase-backed but runs entirely
# through the backend's /auth endpoints, so the app holds no Supabase or
# Firebase keys of its own. (Push notifications use the backend's Firebase
# service account server-side; the device token is registered after sign-in.)
