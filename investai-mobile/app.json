{
  "expo": {
    "name": "InvestAI",
    "slug": "investai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D9F4EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.investai.mobile",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D9F4EA"
      },
      "edgeToEdgeEnabled": true,
      "package": "lk.investai.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0052FF",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2e86bffc-a2ee-480c-8f21-c02f613f697a"
      }
    },
    "owner": "sanjeevsanjay"
  }
}
